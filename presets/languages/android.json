{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Android project configuration for Renovate (Kotlin/Java + Gradle)",
	"customManagers": [
		{
			"customType": "regex",
			"description": "ktlint の版をリポジトリルートなどの .ktlint-version（x.y.z のみを書いたファイル）から検出する",
			"managerFilePatterns": ["/(^|/)\\.ktlint-version$/"],
			"matchStrings": ["^\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
			"depNameTemplate": "ktlint/ktlint",
			"datasourceTemplate": "github-releases"
		}
	],
	"packageRules": [
		{
			"matchDatasources": ["maven"],
			"semanticCommitType": "chore",
			"semanticCommitScope": "deps-android"
		},
		{
			"matchDatasources": ["maven"],
			"matchUpdateTypes": ["major"],
			"groupName": "Android major updates"
		},
		{
			"matchDatasources": ["maven"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Android minor and patch updates"
		},
		{
			"matchPackageNames": ["androidx.**"],
			"groupName": "AndroidX libraries"
		},
		{
			"matchPackageNames": [
				"com.android.tools.**",
				"com.google.android.**",
				"com.google.firebase.**",
				"com.google.gms.**"
			],
			"groupName": "Android Google ecosystem"
		},
		{
			"matchPackageNames": [
				"org.jetbrains.kotlin.**",
				"com.google.devtools.ksp**"
			],
			"groupName": "Android Kotlin toolchain"
		},
		{
			"matchManagers": ["gradle-wrapper"],
			"groupName": "Gradle wrapper"
		}
	]
}
