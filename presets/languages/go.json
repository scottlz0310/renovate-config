{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Go project configuration for Renovate",
	"packageRules": [
		{
			"matchDatasources": ["go"],
			"groupName": "Go dependencies",
			"semanticCommitType": "chore",
			"semanticCommitScope": "deps-go"
		},
		{
			"matchDatasources": ["go"],
			"matchUpdateTypes": ["major"],
			"groupName": "Go major updates"
		},
		{
			"matchDatasources": ["go"],
			"matchUpdateTypes": ["minor", "patch"],
			"groupName": "Go minor and patch updates"
		},
		{
			"matchPackageNames": ["golang"],
			"groupName": "Go version"
		},
		{
			"matchPackageNames": ["github.com/**"],
			"groupName": "GitHub Go packages"
		}
	],
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
			"matchStrings": [
				"(?:^|\\r?\\n)[\\t ]*(?:-[\\t ]+)?(?:run:[\\t ]*)?[\"']?go[\\t ]+install[\\t ]+(?<depName>[^\\s@\"']+)@(?<currentValue>v\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?)(?:[\\t \\r\\n\"']|$)"
			],
			"datasourceTemplate": "go"
		}
	],
	"postUpdateOptions": ["gomodTidy"]
}
