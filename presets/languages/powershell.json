{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "PowerShell Gallery module updates in workflows and scripts",
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": [
				"/^\\.github/workflows/[^/]+\\.ya?ml$/",
				"/\\.ps[dm]?1$/"
			],
			"matchStrings": [
				"#[ \\t]*renovate:[ \\t]+datasource=nuget[ \\t]+registryUrl=https://www\\.powershellgallery\\.com/api/v2[ \\t]+depName=(?<depName>[A-Za-z][A-Za-z0-9._-]*)[ \\t]*\\r?\\n[ \\t]*(?:run:[ \\t]*)?Install-Module[ \\t]+(?:-Name[ \\t]+)?[A-Za-z][A-Za-z0-9._-]*[ \\t]+-RequiredVersion[ \\t]+[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+(?:-[A-Za-z0-9.-]+)?)[\"']?"
			],
			"datasourceTemplate": "nuget",
			"registryUrlTemplate": "https://www.powershellgallery.com/api/v2"
		}
	],
	"packageRules": [
		{
			"matchManagers": ["custom.regex"],
			"matchRegistryUrls": ["https://www.powershellgallery.com/api/v2"],
			"groupName": "PowerShell modules",
			"semanticCommitType": "chore",
			"semanticCommitScope": "deps-powershell"
		}
	]
}
