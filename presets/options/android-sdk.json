{
	"$schema": "https://docs.renovatebot.com/renovate-schema.json",
	"description": "Android SDK の安定版更新（マイナー API レベル・AGP 9 ブロック構文対応）を提案する任意選択プリセット。言語別プリセットより後に指定する。",
	"customManagers": [
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)build\\.gradle\\.kts$/"],
			"matchStringsStrategy": "recursive",
			"matchStrings": [
				"(?:^|\\r?\\n)android[\\t ]*\\{[\\s\\S]*?\\r?\\n\\}",
				"(?:^|\\r?\\n)(?<indentation>[\\t ]*)(?:compileSdk[\\t ]*=[\\t ]*(?<majorInt>\\d+)|compileSdk[\\t ]*\\{[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*version[\\t ]*=[\\t ]*release\\([\\t ]*(?<majorBlock>\\d+)[\\t ]*\\)(?:[\\t ]*\\{[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*(?:it\\.)?minorApiLevel[\\t ]*=[\\t ]*(?<minor>\\d+)[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*\\})?[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*\\})[\\t ]*(?://[^\\r\\n]*)?(?:\\r?\\n|$)",
				"compileSdk[\\t ]*=[\\t ]*\\d+|compileSdk[\\t ]*\\{[\\s\\S]*\\}"
			],
			"currentValueTemplate": "{{{majorInt}}}{{{majorBlock}}}.{{#if minor}}{{{minor}}}{{else}}0{{/if}}",
			"autoReplaceStringTemplate": "{{#if newMinor}}compileSdk {\n{{{indentation}}}{{{indentation}}}version = release({{{newMajor}}}) {\n{{{indentation}}}{{{indentation}}}{{{indentation}}}{{#if (containsString replaceString 'it.minorApiLevel')}}it.{{/if}}minorApiLevel = {{{newMinor}}}\n{{{indentation}}}{{{indentation}}}{{!}}}\n{{{indentation}}}{{!}}}{{else}}{{#if (containsString replaceString 'release(')}}compileSdk {\n{{{indentation}}}{{{indentation}}}version = release({{{newMajor}}})\n{{{indentation}}}{{!}}}{{else}}compileSdk = {{{newMajor}}}{{/if}}{{/if}}",
			"depNameTemplate": "android-compile-sdk",
			"depTypeTemplate": "compileSdk",
			"packageNameTemplate": "latest",
			"datasourceTemplate": "custom.android-sdk",
			"versioningTemplate": "loose"
		},
		{
			"customType": "regex",
			"managerFilePatterns": ["/(^|/)build\\.gradle\\.kts$/"],
			"matchStringsStrategy": "recursive",
			"matchStrings": [
				"(?:^|\\r?\\n)android[\\t ]*\\{[\\s\\S]*?\\r?\\n\\}",
				"(?:^|\\r?\\n)[\\t ]*(?:compileSdk[\\t ]*=[\\t ]*(?<compileSdkInt>\\d+)|compileSdk[\\t ]*\\{[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*version[\\t ]*=[\\t ]*release\\([\\t ]*(?<compileSdkBlock>\\d+)[\\t ]*\\)(?:[\\t ]*\\{[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*(?:it\\.)?minorApiLevel[\\t ]*=[\\t ]*\\d+[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*\\})?[\\t ]*(?://[^\\r\\n]*)?\\r?\\n[\\t ]*\\})[\\t ]*(?://[^\\r\\n]*)?(?:\\r?\\n|$)[\\s\\S]*",
				"(?:^|\\r?\\n)[\\t ]*targetSdk[\\t ]*=[\\t ]*(?<currentValue>\\d+)[\\t ]*(?://[^\\r\\n]*)?(?:\\r?\\n|$)"
			],
			"depNameTemplate": "android-target-sdk",
			"depTypeTemplate": "targetSdk",
			"packageNameTemplate": "{{{compileSdkInt}}}{{{compileSdkBlock}}}",
			"datasourceTemplate": "custom.android-sdk",
			"versioningTemplate": "loose"
		}
	],
	"customDatasources": {
		"android-sdk": {
			"defaultRegistryUrlTemplate": "https://dl.google.com/android/repository/repository2-3.xml",
			"format": "plain",
			"transformTemplates": [
				"($xml := $join(releases.version, '\\n'); $pkgs := [$match($xml, /<remotePackage path=\"platforms;android-(\\d+(?:\\.\\d+)?)\"[^>]*>([\\s\\S]*?)<\\/remotePackage>/)]; $stable := [$pkgs[$exists($match(groups[1], /<channelRef\\s+ref=[\"']channel-0[\"']\\s*\\/>/)) and $not($exists($match(groups[1], /<codename>\\s*[^\\s<][^<]*<\\/codename>/)))].groups[0]]; $versions := ('{{{packageName}}}' = 'latest') ? [$distinct($map($stable, function($v) { $contains($v, '.') ? $v : $v & '.0' }))] : [$distinct($map($stable, function($v) { $contains($v, '.') ? $substringBefore($v, '.') : $v }))[$number($) <= $number('{{{packageName}}}')]]; {\"releases\": [$map($versions, function($v) { {\"version\": $v, \"isStable\": true} })], \"homepage\": \"https://developer.android.com/about/versions\"})"
			]
		}
	},
	"packageRules": [
		{
			"matchDatasources": ["custom.android-sdk"],
			"groupName": null,
			"automerge": false,
			"minimumReleaseAge": null,
			"autoReplaceGlobalMatch": false,
			"dependencyDashboardApproval": false,
			"prCreation": "immediate",
			"semanticCommitType": "chore",
			"semanticCommitScope": "android-sdk"
		},
		{
			"matchDatasources": ["custom.android-sdk"],
			"matchDepTypes": ["compileSdk"],
			"prBodyNotes": ["compileSdk の更新です。ビルド・Android Lint・既存テストを実行してください。targetSdk は現在の compileSdk のメジャー API レベル以下まで別 PR で提案します。"]
		},
		{
			"matchDatasources": ["custom.android-sdk"],
			"matchDepTypes": ["targetSdk"],
			"addLabels": ["manual-verification-required"],
			"prBodyNotes": [
				"この PR は Android SDK 設定を更新します。特に targetSdk の引き上げは、アプリの実行時動作を変更します。",
				"CI が成功しても、テスト端末の API レベルやテスト範囲によっては、edge-to-edge・WindowInsets に関する表示崩れや動作変更を検出できません。マージ前に、対象 API の公式の動作変更を確認し、更新後の target API に対応する Android バージョンの実機またはエミュレータで、主要画面・画面遷移・システムバーとの重なりを手動確認してください。既存の UI テストも実行してください。"
			]
		}
	]
}
